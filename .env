# Subdomains of localhost resolve to the loopback address on the host (RFC 6761), and to the containers
# through the network aliases in compose.yaml. Therefore, the ports on the host and in the containers are the same.
HUB_URL=http://hub.localhost:8280
HUB_PORT=8280

HUB_KEYCLOAK_URL=http://keycloak.localhost:8380
HUB_KEYCLOAK_HOSTNAME=keycloak.localhost
HUB_KEYCLOAK_HTTP_PORT=8380
HUB_KEYCLOAK_HTTPS_PORT=8443
HUB_KEYCLOAK_BASEPATH=
HUB_KEYCLOAK_REALM=cryptomator
HUB_KEYCLOAK_SYSTEM_CLIENT_SECRET=top-secret
HUB_KEYCLOAK_OIDC_CRYPTOMATOR_VAULTS_CLIENT_SECRET=top-secret

HUB_ADMIN_USER=admin
HUB_ADMIN_PASSWORD=admin

MINIO_HOSTNAME=minio.localhost
MINIO_SCHEME=http
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101


HUB_INITIAL_..AZrb7lULe-bvea6LyFsTq7dZZBozgXuqEnr8M5nua-3KyM6gZw_hygBVkmAZw-u4NMlG8u0GEpKlK9rmLUPOpF36AaTa3h9WCQIzmiqn30Rm_zRd9T3WrmWXjkmWKnv7YpfufZI_zT-lpcKGasGm1w3YVWu_nSa9gQd_0Pm1r3QSQWTX
HUB_INITIAL_ID=42

# Additional connect-src sources for the Content-Security-Policy header of Katta Server,
# required for the S3 and STS endpoints of storage profiles created in Katta Web.
#CSP_CONNECT_SRC_EXTRA=*.amazonaws.com https://*.wasabisys.com

# Directory with the MinIO policies and storage profiles to set up.
# Relative paths resolve against the directory containing compose.yaml.
#SETUP_DIR=./setup

# Helm chart of Katta Server from katta-helm to render the Keycloak realm from, in the latest version of major version 1.
# Set KATTA_CHART_VERSION to an exact version for reproducible setups, or leave it empty for the latest version.
#KATTA_CHART=oci://ghcr.io/shift7-ch/katta-helm/katta-server
KATTA_CHART_VERSION=^1

# Image to build Katta Server from.
#KATTA_SERVER_IMAGE=ghcr.io/shift7-ch/katta-server:latest
